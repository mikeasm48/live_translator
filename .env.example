# Скопируйте в .env и заполните:  cp .env.example .env && chmod 600 .env
# Файл .env в .gitignore и в репозиторий не попадёт.

YC_FOLDER_ID=b1g...

# Вариант 1: ключ прямо здесь. Просто, но секрет лежит на диске открытым.
YC_API_KEY=AQVN...

# Вариант 2 (надёжнее): ключ в Keychain, здесь только команда его достать.
# Положить туда ключ один раз:
#   security add-generic-password -a "$USER" -s live-translator -w
# затем убрать строку YC_API_KEY выше и раскомментировать эту:
# YC_API_KEY_CMD=security find-generic-password -s live-translator -w

# Источник звука по умолчанию — подстрока имени устройства.
# Список доступных: java -jar target/live-translator.jar --list-devices
LT_DEVICE=BlackHole
